{
  "id": null,
  "uid": "backend-overview",
  "title": "Backend Overview",
  "tags": ["backend", "zw-app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (method, status)", "legendFormat": "{{method}} {{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s" }
      ]
    },
    {
      "id": 3,
      "title": "p95 request latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 4,
      "title": "Backend pod restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"default\", pod=~\"backend.*\"}) by (pod)", "legendFormat": "{{pod}}" }
      ]
    }
  ]
}